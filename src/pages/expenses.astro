---
import Layout from "@/layouts/Layout.astro";
import ExpensesApp from "@/components/expenses/ExpensesApp";
import { createClient } from "@/lib/supabase";
import { selectCurrentMonthExpenses } from "@/lib/services/expense-query";
import type { Expense } from "@/types";

const { user } = Astro.locals;

let expenses: Expense[] = [];
let loadError = false;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const { data, error } = await selectCurrentMonthExpenses(supabase);
  if (error) {
    // eslint-disable-next-line no-console -- observability sink for wrangler tail
    console.error("expenses: list query failed", error);
    loadError = true;
  }
  expenses = (data ?? []) as Expense[];
} else {
  loadError = true;
}
---

<Layout title="CashCheck — wydatki">
  <div class="bg-cosmic min-h-screen">
    <!-- Full-bleed bar: the app frame, not a floating card (see .impeccable.md). -->
    <header class="border-ink-800 border-b">
      <div class="mx-auto flex w-full max-w-[88rem] items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <div class="flex items-baseline gap-3">
          <span class="font-display text-ink-100 text-xl font-bold tracking-tight">CashCheck</span>
          <span class="text-ink-500 hidden text-xs sm:inline">{user?.email}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <a
            href="/api/expenses/export.csv"
            class="text-ink-300 hover:bg-ink-850 hover:text-ink-100 rounded-md px-3 py-1.5 text-sm transition-colors"
          >
            Eksport CSV
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="text-ink-400 hover:bg-ink-850 hover:text-ink-100 rounded-md px-3 py-1.5 text-sm transition-colors"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-[88rem] px-5 py-8 sm:px-8 sm:py-10">
      {
        loadError && (
          <p class="border-alert/40 bg-alert/10 mb-6 rounded-md border px-3 py-2 text-sm text-red-200">
            Nie udało się wczytać wydatków — odśwież stronę lub spróbuj później.
          </p>
        )
      }
      <ExpensesApp client:load initialExpenses={expenses} />
    </main>
  </div>
</Layout>
