---
import Layout from "@/layouts/Layout.astro";
import ExpensesApp from "@/components/expenses/ExpensesApp";
import { createClient } from "@/lib/supabase";
import { selectCurrentMonthExpenses } from "@/lib/services/expense-query";
import type { Expense } from "@/types";

const { user } = Astro.locals;

let expenses: Expense[] = [];
let loadError = false;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const { data, error } = await selectCurrentMonthExpenses(supabase);
  if (error) {
    // eslint-disable-next-line no-console -- observability sink for wrangler tail
    console.error("expenses: list query failed", error);
    loadError = true;
  }
  expenses = (data ?? []) as Expense[];
} else {
  loadError = true;
}
---

<Layout title="CashCheck — wydatki">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto flex w-full max-w-xl flex-col gap-6">
      <header class="flex items-center justify-between gap-3">
        <div>
          <h1
            class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl"
          >
            CashCheck
          </h1>
          <p class="text-xs text-blue-100/50">{user?.email}</p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/api/expenses/export.csv"
            class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
          >
            Eksport CSV
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </header>
      {
        loadError && (
          <p class="rounded-lg border border-red-400/40 bg-red-500/10 px-3 py-2 text-sm text-red-100">
            Nie udało się wczytać wydatków — odśwież stronę lub spróbuj później.
          </p>
        )
      }
      <ExpensesApp client:load initialExpenses={expenses} />
    </div>
  </div>
</Layout>
